# Receipt Wrangler Configuration
# Copy this file to .env and update with your values

# Port to expose the application on
PORT=8080

# Required: JWT signing key (generate with: openssl rand -base64 32)
SECRET_KEY=

# Required: Data encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Database Configuration
DB_ENGINE=sqlite
DB_FILENAME=wrangler.sqlite

# PostgreSQL Configuration (uncomment if using PostgreSQL)
# DB_ENGINE=postgresql
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=receiptwrangler
# DB_USER=receiptwrangler
# DB_PASSWORD=

# Features
ENABLE_LOCAL_SIGN_UP=true
AI_POWERED_RECEIPTS=false

# Redis Configuration
# When using docker-compose, use service name 'redis'
# For standalone containers, use hostname or IP
REDIS_HOST=redis
REDIS_PORT=6379
